      "token_endpoint": "https://${mosip.api.public.host}/v1/mimoto/get-token/Reneic",
      "proxy_token_endpoint": "https://${mosip.esignet.host}/v1/esignet/oauth/v2/token",
      "qr_code_type": "OnlineSharing",
      "enabled": "true"
    }
  ]
