{
  "issuers": [
    {
      "credential_issuer": "Reneic",
      "display": [
        {
          "name": "DNI Digital",
          "logo": {
            "url": "https://peru-id.github.io/inji-config/Logo/Reniec.JPG",
            "alt_text": "Reneic-logo"
          },
          "title": "DNI Digital",
          "description": "Download Reneic Identity Credential",
          "language": "en"
        },
        {
          "name": "DNI Digital",
          "logo": {
            "url": "https://peru-id.github.io/inji-config/Logo/Reniec.JPG",
            "alt_text": "logotipo-reniec"
          },
          "title": "DNI Digital",
          "description": "Descargar Credencial de Identidad Reniec",
          "language": "es"
        }
